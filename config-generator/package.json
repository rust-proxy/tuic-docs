{
  "name": "config-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "wasm": "wasm-pack build --target web --out-dir pkg --out-name engine --release --locked",
    "dev": "npm run wasm && vite --host 127.0.0.1 --port 8080",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "npm run wasm && npm run check && vite build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte": "5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "wasm-pack": "0.15.0"
  }
}

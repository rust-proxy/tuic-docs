<config-dsl version="4" target-version="2.0.0-dev4">
	<ui title="配置文件生成器" brand="TUIC" mark="T" eyebrow="TUIC 2.0.0-dev4 · QUINN"
		description="填写连接信息，生成相互匹配的服务端与客户端配置。"
		reference="https://docs.ihsin.dev/tuic/tools/config-generator-reference/" mode-field="mode" format-field="format"
		export-hint="复制和下载始终包含真实密码。配对模式请分别保存两份配置。">
		<section name="addresses" label="连接信息"/>
		<section name="authentication" label="用户认证"/>
		<section name="tls" label="TLS 与证书">
			<notice when="acme" text="域名需指向服务器，ACME HTTP-01 验证使用 TCP 80；同时开放 TUIC 的 UDP 监听端口。"/>
			<notice when="serverSelf" text="自签名仅用于受控测试。配对测试需明确跳过证书校验。"/>
		</section>
		<section name="local" label="本地代理" when="client"/>
		<section name="transport" label="高级选项" detail="日志 · 重连 · 端口转发" collapsed="true">
			<notice text="客户端 UDP 模式、自定义信任证书和拥塞控制暂未接入运行逻辑，本生成器不输出这些选项。"/>
		</section>
		<notice when="insecureClient" text="当前客户端配置跳过证书校验，仅适合受控测试。"/>
		<notice when="exposedLocal" text="SOCKS5 正在监听非回环地址且未启用认证，请确认访问范围。"/>
		<notice when="zeroRtt" text="0-RTT 早期数据可能被重放。"/>
		<notice text="此处仅检查配置字段。证书文件、DNS、防火墙和实际连接需要在部署环境验证。"/>
	</ui>
	<validators>
		<validator name="required" kind="required" message="请填写此项。"/>
		<validator name="host" kind="host" message="请输入可连接的域名或 IP，不含端口、路径或通配监听地址。"/>
		<validator name="port" kind="integer" min="1" max="65535" message="端口必须是 1–65535 的整数。"/>
		<validator name="socket" kind="socket" message="请输入有效的 IP:端口；IPv6 使用方括号。"/>
		<validator name="email" kind="email" message="请填写有效的邮箱地址。"/>
		<validator name="socks-credential" kind="length" nonblank="true" min="1" max="255" message="SOCKS5 认证字段必须为 1–255 字节。"/>
		<validator name="milliseconds" kind="integer" min="1" max="9007199254740991" message="请输入大于 0 的安全整数（毫秒）。"/>
		<validator name="seconds" kind="integer" min="1" max="9007199254740991" message="请输入大于 0 的安全整数（秒）。"/>
		<validator name="endpoint" kind="endpoint" message="目标必须是域名或 IP 加端口。"/>
		<validator name="password" kind="length" min="1" message="请输入密码，或点击生成凭据。"/>
		<validator name="uuid" kind="uuid" transform="trim lowercase" message="请输入非全零的标准 UUID，或点击生成凭据。"/>
		<validator name="domain" kind="domain" message="请填写有效的 DNS 域名。"/>
		<validator name="publicDomain" kind="public-domain" message="请填写公开域名。"/>
		<validator name="loopback" kind="loopback-socket" message="请使用回环监听地址。"/>
	</validators>
	<effects><reset on="tlsMode" target="insecure"/></effects>
	<rules>
		<assert key="sni" when="client" message="请填写证书对应的 DNS 域名作为 SNI。"><valid ref="clientSni" rule="domain"/></assert>
		<assert key="hostname" when="server" message="请填写有效的证书域名。"><valid ref="serverHostname" rule="domain"/></assert>
		<assert key="hostname" when="acme" message="ACME 需要公开域名。"><valid ref="serverHostname" rule="publicDomain"/></assert>
		<assert key="insecure" when="pairedSelf" message="自签名测试需要明确开启跳过证书校验，或改用受信任证书。"><truthy from="/insecure"/></assert>
		<assert key="maxBackoff" when="validBackoff" message="最大等待不能小于首次等待。"><compare op="gte"><source from="/maxBackoff" transform="integer"/><source from="/initialBackoff" transform="integer"/></compare></assert>
		<unique collection="users" key="uuid" message="UUID 重复，请为每个用户使用不同 UUID。"><source from="uuid" transform="trim lowercase"/></unique>
		<unique collection="forwards" key="listen" when="validBinding" message="同一协议的监听地址重复。"><source from="protocol"/><source from="listen" transform="socket"/></unique>
		<assert collection="forwards" key="listen" when="validPorts" message="请使用与 SOCKS5 不同的监听端口。"><compare op="ne"><source from="listen" transform="port"/><source from="/local" transform="port"/></compare></assert>
	</rules>
	<inputs>
		<field name="mode" type="enum" default="pair" section="mode" label="生成模式">
			<option value="pair" label="配对生成" />
			<option value="server" label="仅服务端" />
			<option value="client" label="仅客户端" />
		</field>
		<field name="format" type="enum" default="toml" section="format" label="输出格式">
			<option value="toml" label="TOML" />
			<option value="json" label="JSON" />
			<option value="yaml" label="YAML" />
		</field>
		<field name="host" type="string" default="" section="addresses" label="连接域名或 IP" placeholder="tuic.example.com" hint="客户端实际连接的主机，不含协议、路径或端口。" when="client" rule="host" />
		<field name="port" type="string" default="8443" section="addresses" label="连接端口" placeholder="8443" hint="客户端连接的 UDP 端口；可与监听端口不同。" widget="number" when="client" rule="port" />
		<field name="listen" type="string" default="[::]:8443" section="addresses" label="服务端监听地址" placeholder="[::]:8443" hint="必须是 IP:端口；IPv6 使用方括号。" when="server" rule="socket" />
		<field name="tlsMode" type="enum" default="certificate" section="tls" label="服务端证书方式" when="server">
			<option value="certificate" label="已有受信任证书" />
			<option value="acme" label="ACME 自动证书" />
			<option value="self" label="自签名测试" />
		</field>
		<field name="hostname" type="string" default="" section="tls" label="证书域名" placeholder="tuic.example.com" hint="留空时采用连接域名；单独生成服务端时必填。" when="server" />
		<field name="certificate" type="string" default="/etc/tuic/fullchain.pem" section="tls" label="服务端证书路径" placeholder="/etc/tuic/fullchain.pem" hint="部署机器上的证书链文件路径。" when="certificate" rule="required" />
		<field name="privateKey" type="string" default="/etc/tuic/privatekey.pem" section="tls" label="服务端私钥路径" placeholder="/etc/tuic/privatekey.pem" hint="只填写路径，不要粘贴私钥内容。" when="certificate" rule="required" />
		<field name="email" type="string" default="" section="tls" label="ACME 联系邮箱" placeholder="admin@example.com" hint="用于证书申请。" widget="email" when="acme" rule="email" />
		<field name="dataDir" type="string" default="/var/lib/tuic" section="tls" label="服务端数据目录" placeholder="/var/lib/tuic" hint="ACME 缓存目录需要可写，并在容器中持久化。" when="acme" rule="required" />
		<field name="sni" type="string" default="" section="tls" label="客户端 SNI" placeholder="tuic.example.com" hint="留空时使用证书域名或连接域名；连接 IP 时需填写。" when="client" />
		<field name="insecure" type="boolean" default="false" section="tls" label="跳过证书校验（仅测试）" hint="会失去服务端身份验证；默认关闭。" when="client" />
		<field name="local" type="string" default="127.0.0.1:1080" section="local" label="本地 SOCKS5 监听地址" placeholder="127.0.0.1:1080" hint="默认只接受本机连接；对外监听时建议设置认证。" when="client" rule="socket" />
		<field name="localAuth" type="boolean" default="false" section="local" label="启用 SOCKS5 用户名和密码" hint="监听非本机地址时建议设置认证。" when="client" />
		<field name="localUsername" type="string" default="" section="local" label="SOCKS5 用户名" hint="与 TUIC 服务端认证相互独立。" when="localAuth" rule="socks-credential" />
		<field name="localPassword" type="string" default="" section="local" label="SOCKS5 密码" hint="与用户名同时设置。" widget="password" when="localAuth" rule="socks-credential" />
		<field name="logLevel" type="enum" default="info" section="transport" label="日志级别">
			<option value="trace" label="trace" />
			<option value="debug" label="debug" />
			<option value="info" label="info" />
			<option value="warn" label="warn" />
			<option value="error" label="error" />
			<option value="off" label="off" />
		</field>
		<field name="zeroRtt" type="boolean" default="false" section="transport" label="启用 0-RTT" hint="默认关闭；早期数据可能被重放。配对模式会同时设置两端。" />
		<field name="controller" type="enum" default="bbr" section="transport" label="服务端拥塞控制" when="server">
			<option value="bbr" label="BBR" />
			<option value="bbr3" label="BBR3（当前与 BBR 共用实现）" />
			<option value="cubic" label="CUBIC" />
			<option value="newreno" label="New Reno" />
		</field>
		<field name="lazy" type="boolean" default="true" section="transport" label="按需连接" hint="默认开启，首次代理请求时才连接服务端。" when="client" />
		<field name="reconnect" type="boolean" default="true" section="transport" label="断线自动重连" hint="默认开启，重试间隔按退避策略增加。" when="client" />
		<field name="initialBackoff" type="string" default="500" section="transport" label="首次重连等待（毫秒）" placeholder="500" hint="首次重连前等待的时间。" widget="number" when="reconnect" rule="milliseconds" />
		<field name="maxBackoff" type="string" default="30000" section="transport" label="最大重连等待（毫秒）" placeholder="30000" hint="应大于或等于首次等待时间。" widget="number" when="reconnect" rule="milliseconds" />
		<field name="activeUser" type="integer" default="0" section="internal" label="客户端使用的用户" />
		<collection name="users" initial-items="1" min-items="1" label="用户" section="authentication" add-label="＋ 添加用户" generate-label="生成凭据" hint="配对配置自动使用相同的 UUID 和密码。" selected-by="activeUser" all-when="server" select-when="client">
			<field name="uuid" type="string" default="" label="UUID" rule="uuid" generator="uuid-v4" />
			<field name="password" type="string" default="" label="密码" widget="password" rule="password" generator="hex" bytes="24" />
		</collection>
		<collection name="forwards" initial-items="0" when="client" label="转发" section="transport" add-label="＋ 添加转发" hint="服务端默认拦截回环和私有目标地址。">
			<field name="protocol" type="enum" default="tcp" label="转发协议">
				<option value="tcp" label="TCP" />
				<option value="udp" label="UDP" />
			</field>
			<field name="listen" type="string" default="" label="本地监听地址" placeholder="127.0.0.1:8080" rule="socket" />
			<field name="remote" type="string" default="" label="远端目标地址" placeholder="example.com:80" rule="endpoint" />
			<field name="timeout" type="string" default="60" label="会话超时（秒）" widget="number" when="udp" rule="seconds" />
		</collection>
	</inputs>
	<conditions>
		<condition name="server"><not><eq from="/mode" value="client"/></not></condition>
		<condition name="client"><not><eq from="/mode" value="server"/></not></condition>
		<condition name="certificate"><all><use ref="server"/><eq from="/tlsMode" value="certificate"/></all></condition>
		<condition name="acme"><all><use ref="server"/><eq from="/tlsMode" value="acme"/></all></condition>
		<condition name="self"><eq from="/tlsMode" value="self"/></condition>
		<condition name="localAuth"><all><use ref="client"/><truthy from="/localAuth"/></all></condition>
		<condition name="reconnect"><all><use ref="client"/><truthy from="/reconnect"/></all></condition>
		<condition name="zeroRtt"><truthy from="/zeroRtt"/></condition>
		<condition name="udp"><eq from="protocol" value="udp"/></condition>
		<condition name="ip"><ip ref="host"/></condition>
		<condition name="serverSelf"><all><use ref="server"/><use ref="self"/></all></condition>
		<condition name="pairedSelf"><all><use ref="serverSelf"/><use ref="client"/></all></condition>
		<condition name="insecureClient"><all><use ref="client"/><truthy from="/insecure"/></all></condition>
		<condition name="exposedLocal"><all><use ref="client"/><not><truthy from="/localAuth"/></not><valid from="/local" rule="socket"/><not><valid from="/local" rule="loopback"/></not></all></condition>
		<condition name="validBackoff"><all><use ref="reconnect"/><valid from="/initialBackoff" rule="milliseconds"/><valid from="/maxBackoff" rule="milliseconds"/></all></condition>
		<condition name="validBinding"><valid from="listen" rule="socket"/></condition>
		<condition name="validPorts"><all><use ref="validBinding"/><valid from="/local" rule="socket"/></all></condition>
	</conditions>
	<values>
		<value name="host"><source from="/host" transform="trim unbracket"/></value>
		<value name="serverHostname"><coalesce><source from="/hostname" transform="trim"/><source ref="host" when="client"/></coalesce></value>
		<value name="clientSni"><coalesce><source from="/sni" transform="trim"/><source from="/hostname" transform="trim" when="server"/><source ref="host"/></coalesce></value>
	</values>
	<!-- TUIC 4719113 / Wind 9025349: literal output names, no executable code. -->
	<outputs>
		<object name="server" when="server" label="服务端" filename="server" command="tuic-server -c {filename}">
			<string name="server" from="/listen" transform="trim"/>
			<enum name="log_level" from="/logLevel" options="logLevel"/>
			<boolean name="zero_rtt_handshake" value="true" when="zeroRtt"/>
			<string name="data_dir" from="/dataDir" transform="trim" when="acme"/>
			<record name="users" from="/users" key="uuid" key-transform="trim lowercase">
				<string from="password" secret="true"/>
			</record>
			<object name="tls">
				<string name="hostname" ref="serverHostname"/>
				<list name="alpn"><string value="h3"/></list>
				<string name="certificate" from="/certificate" transform="trim" when="certificate"/>
				<string name="private_key" from="/privateKey" transform="trim" when="certificate"/>
				<boolean name="auto_ssl" value="true" when="acme"/>
				<string name="acme_email" from="/email" transform="trim" when="acme"/>
				<boolean name="self_sign" value="true" when="self"/>
			</object>
			<object name="backend">
				<string name="mode" value="quinn"/>
				<object name="quinn"><object name="congestion_control">
					<enum name="controller" from="/controller" options="controller"/>
				</object></object>
			</object>
		</object>
		<object name="client" when="client" label="客户端" filename="client" command="tuic-client -c {filename}">
			<string name="server"><endpoint><source ref="host"/><source from="/port" transform="integer"/></endpoint></string>
			<!-- Explicit IP also avoids the baseline client's IPv6 DNS formatting issue. -->
			<string name="ip" ref="host" when="ip"/>
			<string name="uuid"><select from="/users" index="/activeUser"><source from="uuid" transform="trim lowercase"/></select></string>
			<string name="password" secret="true"><select from="/users" index="/activeUser"><source from="password"/></select></string>
			<enum name="log_level" from="/logLevel" options="logLevel"/>
			<boolean name="zero_rtt_handshake" value="true" when="zeroRtt"/>
			<boolean name="reconnect" from="/reconnect"/>
			<boolean name="lazy" from="/lazy"/>
			<string name="reconnect_initial_backoff" from="/initialBackoff" transform="integer" unit="ms" when="reconnect"/>
			<string name="reconnect_max_backoff" from="/maxBackoff" transform="integer" unit="ms" when="reconnect"/>
			<object name="tls">
				<string name="sni" ref="clientSni"/>
				<list name="alpn"><string value="h3"/></list>
				<boolean name="skip_cert_verify" from="/insecure"/>
			</object>
			<object name="local">
				<string name="server" from="/local" transform="trim"/>
				<string name="username" from="/localUsername" when="localAuth"/>
				<string name="password" from="/localPassword" when="localAuth" secret="true"/>
				<list name="tcp_forward" from="/forwards" where-field="protocol" equals="tcp" omit-empty="true">
					<object>
						<string name="listen" from="listen" transform="trim"/>
						<string name="remote" from="remote" transform="trim"/>
						<string name="timeout" from="timeout" transform="integer" unit="s" when="udp"/>
					</object>
				</list>
				<list name="udp_forward" from="/forwards" where-field="protocol" equals="udp" omit-empty="true">
					<object>
						<string name="listen" from="listen" transform="trim"/>
						<string name="remote" from="remote" transform="trim"/>
						<string name="timeout" from="timeout" transform="integer" unit="s" when="udp"/>
					</object>
				</list>
			</object>
		</object>
	</outputs>
</config-dsl>

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["svelte", "vite/client"]
  },
  "include": ["ui/**/*.ts", "ui/**/*.svelte", "pkg/*.d.ts"]
}
